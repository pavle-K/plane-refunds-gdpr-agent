# Copy to .env and fill in real values. Never commit .env.

# LLM
ANTHROPIC_API_KEY=

# Database (Postgres — Neon, EU region; see CLAUDE.md §Stage 0)
DATABASE_URL=

# Flight data provider (AeroAPI / Cirium — TBD)
FLIGHT_DATA_API_KEY=

# Weather provider
WEATHER_API_KEY=

# Email ingest (Gmail/Outlook OAuth, read-only narrow scope)
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=

# Email out (Postmark or SendGrid)
POSTMARK_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=

# Runtime
NODE_ENV=development
