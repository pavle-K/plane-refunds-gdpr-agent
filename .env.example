# Copy to .env and fill in real values. Never commit .env.

# LLM provider selection — anthropic | openai | google | xai | openai-compatible.
# Switching providers is just these two lines; no code changes.
LLM_PROVIDER=anthropic
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Any OpenAI-compatible endpoint — hosted (OpenRouter, Groq, Together, DeepSeek's
# own API, ...) or self-hosted (Ollama, vLLM, LM Studio). Set LLM_PROVIDER=openai-compatible
# to use this — covers every open-weight model, no per-model adapter needed.
#
# Example: a local Ollama server running Qwen3-8B (self-hosted — no passenger PII
# leaves this machine, so no third-party processor/DPA question for the LLM hop):
#   ollama pull qwen3:8b
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPATIBLE_MODEL=qwen3:8b
#   OPENAI_COMPATIBLE_API_KEY=   # unused by Ollama, leave blank
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Database (Postgres — Neon, EU region; see CLAUDE.md §Stage 0)
DATABASE_URL=

# Flight data provider (AeroAPI / Cirium — TBD)
FLIGHT_DATA_API_KEY=

# Weather provider
WEATHER_API_KEY=

# Email ingest (Gmail/Outlook OAuth, read-only narrow scope — see scripts/connect-email.ts)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=

# Encrypts stored OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Email out (Postmark or SendGrid)
POSTMARK_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=

# Runtime
NODE_ENV=development
