{
  "name": "plane-refunds-gdpr-agent",
  "version": "0.1.0",
  "description": "EC 261/2004 flight compensation claim agent — LangGraph.js, TypeScript, GDPR-first.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prompts": "tsx scripts/eval-prompt.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:stage2": "tsx scripts/verify-stage2.ts",
    "claim:start": "tsx scripts/start-claim.ts",
    "claim:resume": "tsx scripts/resume-claim.ts",
    "email:connect": "tsx scripts/connect-email.ts",
    "email:check": "tsx scripts/check-inbox.ts",
    "test-emails:generate": "tsx scripts/generate-test-emails.ts",
    "airports:import": "tsx scripts/import-airports.ts",
    "chat": "tsx scripts/chat.ts",
    "server": "tsx src/api/server.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "dev:telegram": "tsx scripts/dev-telegram.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@langchain/anthropic": "^1.5.6",
    "@langchain/core": "^1.2.8",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "^1.5.8",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "langchain": "^1.5.9",
    "langfuse": "^3.38.20",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemailer": "^9.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
