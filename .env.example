# Copy to .env and fill in real values. Never commit .env.

# LLM provider selection — anthropic | openai | google | xai | openai-compatible.
# Switching providers is just these two lines; no code changes.
LLM_PROVIDER=anthropic
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Any OpenAI-compatible endpoint — hosted (OpenRouter, Groq, Together, DeepSeek's
# own API, ...) or self-hosted (Ollama, vLLM, LM Studio). Set LLM_PROVIDER=openai-compatible
# to use this — covers every open-weight model, no per-model adapter needed.
#
# Example: a local Ollama server running Qwen3-8B (self-hosted — no passenger PII
# leaves this machine, so no third-party processor/DPA question for the LLM hop):
#   ollama pull qwen3:8b
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPATIBLE_MODEL=qwen3:8b
#   OPENAI_COMPATIBLE_API_KEY=   # unused by Ollama, leave blank
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Database (Postgres — Neon, EU region; see CLAUDE.md §Stage 0)
DATABASE_URL=

# Flight data provider (AeroAPI / Cirium — TBD)
FLIGHT_DATA_API_KEY=

# Email ingest (Gmail/Outlook OAuth, read-only narrow scope).
#
# Two OAuth flows use these same credentials:
#   - Local loopback (scripts/connect-email.ts, npm run chat) — registered
#     redirect URI must be exactly http://localhost:8765/callback.
#   - Hosted (any messaging channel, e.g. Telegram) — registered redirect URI
#     must be exactly ${PUBLIC_URL}/oauth/gmail/callback (and .../outlook/callback).
#     Uses PKCE automatically; no extra config needed for that.
#
# Manual prerequisites for the hosted flow to work with real (non-developer)
# users, not just code:
#   - Google Cloud Console / Azure: add the hosted redirect URI above as an
#     authorized redirect URI for your OAuth app.
#   - Google specifically: move the OAuth consent screen out of "Testing" mode
#     — gmail.readonly is a sensitive scope, and Google requires app
#     verification review before real third-party users (not just your own
#     account) can complete it. This can take real review time — start early.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=

# Encrypts stored OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Email out (Postmark or SendGrid)
POSTMARK_API_KEY=

# The From: address outbound claim letters are sent from. Must be on a domain you
# actually control AND be verified with your email provider (Postmark calls this a
# Sender Signature) — otherwise sends are rejected, or the airline's reply goes
# somewhere nobody reads. There is deliberately no default: sendClaim refuses to
# send at all rather than fall back to a placeholder address.
CLAIM_SENDER_EMAIL=

# Payments
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=

# Messaging channels (src/channels/) — lets users chat with the operator over
# apps other than the CLI. Each is optional; unset falls back to a fake adapter.
#
# Telegram setup:
#   1. Message @BotFather on Telegram, run /newbot, copy the token it gives you.
#   2. TELEGRAM_WEBHOOK_SECRET — any random string, e.g.:
#        node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   3. After `npm run server` is reachable at a public HTTPS URL, register the webhook:
#        curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#          -d "url=https://<your-domain>/webhooks/telegram" \
#          -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Used only by scripts/dev-telegram.ts (npm run dev:telegram), not the app
# itself. Set to a domain from https://dashboard.ngrok.com/domains (ngrok's
# free plan includes one) so the tunnel URL — and so the OAuth redirect URI
# you register with Google/Microsoft — never changes between runs. Without
# this, dev:telegram still works, but a fresh/rotated ngrok tunnel can get a
# different URL, meaning the redirect URI you registered before goes stale.
NGROK_STATIC_DOMAIN=

# The public HTTPS origin this server is reachable at (e.g.
# https://claims.example.com) — used to build the hosted OAuth redirect URI
# (see the email-ingest section above). No trailing slash.
PUBLIC_URL=

# Logging (src/lib/logger.ts) — error | warn | info | debug | trace, least to
# most verbose. Leave both unset for the sane defaults: "info"/"pretty" normally,
# "error"/"pretty" under NODE_ENV=test (so real integration-test paths that log
# through handleTurn stay quiet), "json" format under NODE_ENV=production.
LOG_LEVEL=
LOG_FORMAT=

# Langfuse — LLM tracing (src/agent/llm/tracing.adapter.ts, wired into every
# operator turn) and the dataset-driven prompt eval harness (tests/evals/,
# npm run test:prompts). Optional; unset means both silently no-op, same as
# every other optional provider here.
#
# LANGFUSE_HOST defaults to Langfuse Cloud's EU region if unset — this project
# keeps its Postgres in Frankfurt specifically for EU data residency, and a
# trace can carry a full raw prompt (which includes passenger PII pulled from
# a real conversation), so the same reasoning applies. Only set this to point
# at the US region or a self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Runtime.
#
# NODE_ENV=production additionally REQUIRES TELEGRAM_WEBHOOK_SECRET,
# PUBLIC_URL, and TOKEN_ENCRYPTION_KEY to be set (boot fails otherwise, with
# every missing one named) — see src/config/env.ts.
NODE_ENV=development
PORT=3000

# Dev/test-only, used solely by scripts/generate-test-emails.ts (npm run
# test-emails:generate) — not read by the app itself. Lets that script send a
# realistic booking-confirmation email (built from a REAL AeroAPI flight
# lookup) into your own inbox, to test scan_inbox/extraction without waiting
# for a real recent flight. Any SMTP account works; for Gmail, generate an
# App password (Google Account -> Security -> 2-Step Verification -> App
# passwords) rather than using your real account password.
TEST_EMAIL_SMTP_HOST=
TEST_EMAIL_SMTP_PORT=
TEST_EMAIL_SMTP_USER=
TEST_EMAIL_SMTP_PASS=
